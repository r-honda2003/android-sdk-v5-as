<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <!-- Top Title Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/top_title_bar"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="#1E1E1E"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/selector_back_button"
            android:padding="4dp"
            app:tint="#FFFFFF"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <TextView
            android:id="@+id/tv_top_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Teach &amp; Repeat (Behavior Cloning)"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <Button
            android:id="@+id/btn_backup_files"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginEnd="8dp"
            android:backgroundTint="#FF9800"
            android:text="ファイルをバックアップをとり"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- MSDK Info Banner -->
    <TextView
        android:id="@+id/tv_msdk_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#2B2B2B"
        android:padding="4dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="MSDK Info: [Ver:5.20.1 (2,5) BuildVer:2462 Debug:false LinkMode:LOCAL LDMLicenseLoaded:false]\nDevice:DJI_MINI_4_PRO | Network:ONLINE | CountryCode:JP | FirmwareVer:01.00.1100 | LDMEnabled:false"
        android:textColor="#B0BEC5"
        android:textSize="9sp"
        app:layout_constraintTop_toBottomOf="@id/top_title_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Main Section Title Left -->
    <TextView
        android:id="@+id/tv_main_section_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginStart="8dp"
        android:text="Teach &amp; Repeat (End-to-End Behavior Cloning)"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/right_control_panel"
        app:layout_constraintTop_toBottomOf="@id/tv_msdk_info" />

    <TextView
        android:id="@+id/tv_camera_stream_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="2dp"
        android:text="Camera Stream"
        android:textColor="#4CAF50"
        android:textSize="11sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_main_section_title" />

    <!-- Camera Stream Surface View (Left Column) -->
    <FrameLayout
        android:id="@+id/camera_stream_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:background="#000000"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/right_control_panel"
        app:layout_constraintTop_toBottomOf="@id/tv_camera_stream_label"
        app:layout_constraintBottom_toBottomOf="parent">

        <SurfaceView
            android:id="@+id/sv_camera_stream"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- Right Control Panel (Right Column) -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/right_control_panel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:background="#1E1E1E"
        android:padding="8dp"
        app:layout_constraintWidth_percent="0.45"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_msdk_info"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Control Section Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aircraft Controls"
                android:textColor="#FF9800"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Row 1: Take Off & Auto Landing -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_take_off"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:backgroundTint="#FF9800"
                    android:text="TAKE OFF (離陸)"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_auto_landing"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:backgroundTint="#E91E63"
                    android:text="AUTO LANDING (着陸)"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_climb_to_target_altitude"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="4dp"
                android:backgroundTint="#9C27B0"
                android:text="CLIMB TO 1.7M (指定高度上昇)"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />

            <!-- Aircraft State (Altitude) -->
            <TextView
                android:id="@+id/tv_aircraft_altitude"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="#2A2A3C"
                android:padding="6dp"
                android:text="現在高度 (Altitude): 0.00 m"
                android:textColor="#00E676"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Row 2: RC Stick Status -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="[RC Stick Status (-660 ~ 660)]"
                android:textColor="#FFEB3B"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_rc_stick_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:background="#262626"
                android:padding="6dp"
                android:text="Roll: 0 | Pitch: 0 | Yaw: 0 | Throttle: 0"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:typeface="monospace" />

            <!-- Section 1: Teach Mode (Data Recording) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="1. Teach Mode (Data Recording)"
                android:textColor="#4CAF50"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_start_teach"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:backgroundTint="#2E7D32"
                    android:text="START TEACH REC"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_stop_teach"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:backgroundTint="#C62828"
                    android:text="STOP TEACH REC"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_teach_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="#262626"
                android:padding="6dp"
                android:text="Teach Recording: Stopped\nSaved frames: 0 (Session 1/5)"
                android:textColor="#E0E0E0"
                android:textSize="10sp" />

            <!-- Section 2: Repeat Mode (AI Autonomous Flight) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="2. Repeat Mode (AI Autonomous Flight)"
                android:textColor="#EC407A"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- IP and Port inputs -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/et_server_ip"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="3"
                    android:layout_marginEnd="4dp"
                    android:background="#262626"
                    android:hint="Server IP"
                    android:text="192.168.12.60"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#757575"
                    android:textSize="11sp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:singleLine="true" />

                <EditText
                    android:id="@+id/et_server_port"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:background="#262626"
                    android:hint="Port"
                    android:text="5000"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#757575"
                    android:textSize="11sp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:singleLine="true" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_start_repeat"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:backgroundTint="#1E88E5"
                    android:text="START REPEAT"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_stop_repeat"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:backgroundTint="#C62828"
                    android:text="STOP REPEAT"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_repeat_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="#262626"
                android:padding="6dp"
                android:text="Repeat Flight: Stopped\nServer: 192.168.12.60:5000 | Auto-Override Active"
                android:textColor="#E0E0E0"
                android:textSize="10sp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>